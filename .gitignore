# Keep the Apollo HD map: it is required at runtime but would otherwise be
# caught by the global "*.bin" rule above. Re-include it.
!agent_corpus/apollo/map/
!agent_corpus/apollo/map/**
!agent_corpus/apollo/map/Town01/*.bin
